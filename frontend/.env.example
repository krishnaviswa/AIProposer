# Copy to .env.local for local dev.

# FastAPI /v1 base URL — the ONLY backend the web client talks to.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1

# Supabase project (Auth only — all data goes through FastAPI).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional phone-OTP sign-in (ADR-003). "true" shows the phone option on the
# sign-in page. Keep the backend AUTH_PHONE_OTP flag and the Supabase SMS
# provider (MSG91 for +91) in sync when enabling.
NEXT_PUBLIC_AUTH_PHONE_OTP=false
