# Copy to .env for local dev. docker-compose.yml sets these for Compose.

DEBUG=true
DATABASE_URL=postgresql+asyncpg://aiproposer:aiproposer@localhost:5432/aiproposer
CORS_ORIGINS=http://localhost:3000

# --- Supabase Auth: FastAPI only VERIFIES the JWT (ADR-001) ---
# HS256 (shared project secret) — simplest, no network. Get it from
# Supabase dashboard > Project Settings > API > JWT Settings.
SUPABASE_JWT_ALG=HS256
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWT_AUD=authenticated
# RS256 (asymmetric signing keys) — set ALG=RS256 and point at the JWKS:
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Adapters. Default mock/local; opt in to a real one per env. ---
AI_PROVIDER=mock            # mock | anthropic
PAYMENTS_PROVIDER=mock      # mock | razorpay
STORAGE_PROVIDER=local
EMAIL_PROVIDER=mock

# Claude (AI_PROVIDER=anthropic). Model default is mid-tier per mvp-spec.md §4;
# final pick comes from the ~20-brief benchmark (ADR-002).
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
AI_MAX_TOKENS=2000

# Razorpay (PAYMENTS_PROVIDER=razorpay).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=dev-webhook-secret-change-me

STORAGE_LOCAL_PATH=./uploads
GENERATE_RATE_LIMIT=10/minute
